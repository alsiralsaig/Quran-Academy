# ───── متغيرات البيئة — تتحط في Vercel: Project → Settings → Environment Variables ─────
# ما تحط القيم الحقيقية في GitHub أبداً.

# رابط قاعدة Neon (Connection string — يفضّل النسخة pooled اللي فيها -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# سر توقيع الجلسات — 32 حرف عشوائي على الأقل (مثلاً من: openssl rand -base64 48)
AUTH_SECRET="ضع-هنا-نص-عشوائي-طويل-جداً"

# حساب المدير — بيتنشأ تلقائياً أول مرة بس (لو ما في مدير)
ADMIN_PHONE="0913009060"
ADMIN_PASSWORD="كلمة-سر-قوية"
ADMIN_NAME="الإدارة العامة"

# مفتاح Gemini للمساعد الذكي — بيُستعمل من السيرفر فقط (اختياري)
GEMINI_API_KEY=""
